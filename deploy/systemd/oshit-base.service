[Unit]
Description=OShit Base API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/dist/oshit/base/backend/bin
ExecStart=/data/dist/oshit/base/backend/bin/micro-server
Environment=APP_CONF=/data/dist/oshit/base/backend/etc/application.yaml

# 安全: 禁用 core dump，防止崩溃时明文密码写入磁盘
LimitCORE=0

# 自动重启
Restart=on-failure
RestartSec=3

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oshit-base

[Install]
WantedBy=multi-user.target
